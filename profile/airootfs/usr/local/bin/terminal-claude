#!/usr/bin/env bash
# Terminal Claude: o Claude Code numa janela no estilo do app do Claude.
# Trabalha na pasta ~/Clone; as pastas liberadas e o modo de permissão ficam em
# ~/.claude/settings.json (definidos pelo Clone Welcome).
#
#   terminal-claude            abre a janela gráfica (ícone da área de trabalho, atalho Meta+C)
#   terminal-claude --texto    abre o modo texto (o Claude Code no terminal, com o visual do Claude)
#   terminal-claude [args]     dentro de um terminal: roda o Claude ali mesmo, com esses argumentos
set -u

share=/usr/share/cloneos/terminal-claude
workspace="$HOME/Clone"
clay=$'\e[38;2;217;119;87m'; cream=$'\e[38;2;236;234;227m'; muted=$'\e[38;2;156;153;143m'; bold=$'\e[1m'; off=$'\e[0m'

mkdir -p "$workspace"
[[ -e "$workspace/CLAUDE.md" ]] || cp /usr/share/cloneos/CLAUDE.md "$workspace/CLAUDE.md"

text_window() {
    exec alacritty --config-file "$share/alacritty.toml" --class terminal-claude-texto \
        --title "Terminal Claude (modo texto)" --working-directory "$workspace" -e "$0" --janela "$@"
}

in_window=0
case "${1:-}" in
    --texto)
        shift
        text_window "$@"
        ;;
    --janela)
        in_window=1
        shift
        ;;
    *)
        if [[ ! -t 0 || ! -t 1 ]]; then
            if [[ $# -eq 0 && ( -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ) ]]; then
                exec python3 "$share/claude_app.py"
            fi
            text_window "$@"
        fi
        ;;
esac

cd "$workspace" || exit 1

printf '\n  %s%s✻%s  %s%sTerminal Claude%s\n' "$clay" "$bold" "$off" "$cream" "$bold" "$off"
printf '     %sClaude Code no Clone OS · pasta de trabalho: ~/Clone%s\n\n' "$muted" "$off"
printf '     %s/login%s entrar na conta   %s/help%s comandos   %s!%s comando do sistema   %sCtrl+C 2x%s sair\n\n' \
    "$clay" "$muted" "$clay" "$muted" "$clay" "$muted" "$clay" "$off"

if command -v claude >/dev/null; then
    claude "$@"
else
    printf '  O Claude Code não está instalado. Instale com: %ssudo pacman -S claude-code%s\n' "$clay" "$off"
fi

# Ao sair do Claude, a janela continua como um terminal comum, com o mesmo visual.
(( in_window )) && exec bash --rcfile "$share/bashrc" -i
exit 0
